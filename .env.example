# Copy to .env (never commit .env). Phase 0 needs none of these; adapters only define interfaces.
# Supabase (local `supabase start` prints these)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Market data vendor (D-13, not selected)
MARKETDATA_PROVIDER=fixture
MARKETDATA_API_KEY=
# News / filings (D-15)
SEC_EDGAR_USER_AGENT="baam-stock research contact@example.com"
NEWS_API_KEY=
# Consensus (D-16)
EXPECTATIONS_API_KEY=
# LLM (D-25, Phase 1+)
LLM_PROVIDER=fake
LLM_MODEL=
ANTHROPIC_API_KEY=
# Next.js / Supabase client (names used in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DIRECT_URL=
