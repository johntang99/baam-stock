{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baam-stock.local/contracts/llm_calls.schema.json",
  "title": "llm_calls",
  "description": "contract-0.7.2: one row per LLM call (MP §3.2 调用留痕: provider/model/prompt_version/hash). Append-only.",
  "x-tabled": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "call_id": {
      "type": "string",
      "pattern": "^llm_"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "extract_facts",
        "draft_explanation"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "doc_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay"
      ]
    },
    "request_params": {
      "type": "object",
      "description": "effort, max_tokens, output schema id; tools must be [] (no web search)"
    },
    "usage": {
      "type": "object",
      "description": "input_tokens, output_tokens, cache_* as returned"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "rejected_validation",
        "refused",
        "failed"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "call_id",
    "purpose",
    "provider",
    "model",
    "prompt_version",
    "prompt_hash",
    "input_hash",
    "mode",
    "request_params",
    "usage",
    "status",
    "created_at"
  ],
  "additionalProperties": false
}
