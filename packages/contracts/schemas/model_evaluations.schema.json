{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baam-stock.local/contracts/model_evaluations.schema.json",
  "title": "model_evaluations",
  "description": "DC §3.8 (schema only in P0)",
  "x-tabled": false,
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^eval_"
    },
    "candidate_model_version_id": {
      "type": "string"
    },
    "comparator_model_version_id": {
      "type": "string"
    },
    "eval_subset": {
      "type": "string"
    },
    "common_coverage": {
      "type": "object",
      "properties": {
        "n_eligible": {
          "type": "integer",
          "minimum": 0
        },
        "n_candidate": {
          "type": "integer",
          "minimum": 0
        },
        "n_comparator": {
          "type": "integer",
          "minimum": 0
        },
        "n_common": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "n_eligible",
        "n_candidate",
        "n_comparator",
        "n_common"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "n_independent_days": {
      "type": "integer",
      "minimum": 0
    },
    "n_event_clusters": {
      "type": "integer",
      "minimum": 0
    },
    "gate_config_version": {
      "type": "string"
    },
    "gate_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "failed_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "evaluation_id",
    "candidate_model_version_id",
    "comparator_model_version_id",
    "eval_subset",
    "common_coverage",
    "metrics",
    "n_independent_days",
    "n_event_clusters",
    "gate_config_version",
    "gate_result",
    "failed_conditions"
  ],
  "additionalProperties": false
}
