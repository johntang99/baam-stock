{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baam-stock.local/contracts/collection_items.schema.json",
  "title": "collection_items",
  "description": "DC §3.2: one row per retrieved item, including those not used (append-only)",
  "x-tabled": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "item_id": {
      "type": "string"
    },
    "collection_run_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "channel": {
      "$ref": "common.schema.json#/$defs/collection_channel"
    },
    "submission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "submitted_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "$ref": "common.schema.json#/$defs/collection_category"
    },
    "category_confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "snippet": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "doc_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "kept",
        "duplicate",
        "excluded_irrelevant",
        "excluded_after_asof",
        "excluded_restricted",
        "pending_review",
        "fetch_failed"
      ]
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "relevance": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "linked_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurred_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_published_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_published_precision": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/time_precision"
        },
        {
          "type": "null"
        }
      ]
    },
    "received_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "available_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "item_id",
    "collection_run_id",
    "source_id",
    "channel",
    "category",
    "title",
    "mentions",
    "disposition",
    "linked_evidence_ids"
  ],
  "additionalProperties": false
}
