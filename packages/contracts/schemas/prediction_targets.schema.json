{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baam-stock.local/contracts/prediction_targets.schema.json",
  "title": "prediction_targets",
  "description": "DC §3.7 (versioned target definitions)",
  "x-tabled": true,
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "target_row_id": {
      "type": "string",
      "pattern": "^tgt_"
    },
    "target_id": {
      "$ref": "common.schema.json#/$defs/target_id"
    },
    "target_definition_version": {
      "type": "string"
    },
    "track": {
      "type": "string",
      "enum": [
        "stock_reaction",
        "event_outcome",
        "conditional_scenario"
      ]
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "threshold_rule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "vol_scaled"
              ]
            },
            "k": {
              "type": "number",
              "minimum": 0
            },
            "sigma_model": {
              "type": "string"
            },
            "on_missing_sigma": {
              "type": "string",
              "enum": [
                "abstain"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "k",
            "sigma_model",
            "on_missing_sigma"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "output_kind": {
      "type": "string",
      "enum": [
        "class_probs",
        "quantiles",
        "scenarios"
      ]
    },
    "window_rule": {
      "type": "object"
    },
    "min_remaining_min": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline_tz": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirm_sources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome_resolution": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_result_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "invalid_rules_version": {
      "type": "string"
    }
  },
  "required": [
    "target_row_id",
    "target_id",
    "target_definition_version",
    "track",
    "classes",
    "output_kind",
    "window_rule",
    "invalid_rules_version"
  ],
  "additionalProperties": false
}
